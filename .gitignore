# ---------------------------------------------------------------- toolchains
node_modules/
.venv/
venv/
__pycache__/
*.pyc
# `pip install -e bridge/` drops this next to the package.
*.egg-info/

# ------------------------------------------------------------- build output
build/
out/
.dart_tool/
.gradle/
*.apk
*.aab
*.jks
*.keystore

# Machine-specific SDK paths, not portable and not interesting to anyone else.
local.properties
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ------------------------------------------------------------ model weights
# The MiniLM export is ~90 MB, which is past the point where it belongs in
# git. vault_rag_test/modelprep/ regenerates it end to end (download ONNX,
# rewrite to int32/static, convert, verify) — see BUILD_NOTES.md.
*.tflite
*.onnx
vault_rag_test/assets/models/minilm_l6_v2.tflite

# Piper voice models are similarly large and re-downloadable.
voices/
*.onnx.json

# Rendered video is a build artifact; the project regenerates it.
vault_video/out/
*.mp4

# GGUF weights (Qwen3/SmolLM2 etc.) are side-loaded, never committed — see
# vault_rag_test/model_registry.json for sources and checksums.
*.gguf

# run_eval.py output; per-machine, regenerated on every run.
bridge/corpus/results/
