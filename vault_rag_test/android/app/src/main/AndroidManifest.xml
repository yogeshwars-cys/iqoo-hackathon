<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is the only permission this app requests, and it is here
         solely for the desktop co-processor bridge: the phone dials out to
         a laptop running bridge_server.py over the LAN.

         Everything else in the app - picking files, chunking, embedding,
         the vector store, retrieval, the telemetry charts and the benchmark
         - runs with the radios off and always will. The bridge is opt-in
         per session, defaults to disconnected, and the screen that enables
         it says plainly that retrieved chunks leave the device once it is
         up. See lib/ui/bridge_page.dart.

         Worth knowing for anyone auditing this: ws:// to a private address
         is cleartext, and there is deliberately no
         android:usesCleartextTraffic="true" here. That attribute governs
         the platform HTTP stack; dart:io's WebSocket uses the Dart VM's own
         sockets and never consults it, so setting the flag would weaken the
         app's declared posture for every future component without being
         needed by this one. Android's network security config cannot
         express "private ranges only" - it keys on domains, not CIDR - so
         there is no narrower flag worth adding either.

         No other permission is needed: files arrive through the system
         document picker (which grants per-file access without one) and
         everything else stays in app-private storage. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--

         These three are not written by us or by any plugin - the manifest
         merger injects them via its legacy implied-permission rules, and they
         showed up in a `aapt2 dump permissions` of the first build. Left
         alone, an app whose whole pitch is "asks for nothing" would ship
         asking for external storage and the phone state. Remove them
         explicitly, and re-check with:

           aapt2 dump permissions build\app\outputs\flutter-apk\app-release.apk

         Flutter's tooling also injects INTERNET into the debug and profile
         manifests so `flutter run` can reach the Dart VM. That used to be
         the only place it appeared, and a release build was the proof of
         the no-network claim. Since the bridge landed, release carries it
         too, so the claim is now demonstrated at runtime instead: leave the
         Bridge tab disconnected and no socket is ever opened. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:label="Vault Co-Processor"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
