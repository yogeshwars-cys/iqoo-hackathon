<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- NO NETWORK PERMISSION IN THE MAIN MANIFEST.

         The default `airgap` flavor ships with zero network permissions;
         src/airgapRelease/AndroidManifest.xml additionally strips INTERNET
         and ACCESS_NETWORK_STATE if any library manifest merges them in.
         Only the `lan` flavor (src/lan/AndroidManifest.xml) requests
         INTERNET, for the opt-in WebSocket bridge to bridge_server.py.

         Files arrive through the system document picker (per-file grants,
         no permission), VaultLink travels over the clipboard (no socket),
         and everything else stays in app-private storage. -->

    <!--

         These three are not written by us or by any plugin - the manifest
         merger injects them via its legacy implied-permission rules, and they
         showed up in a `aapt2 dump permissions` of the first build. Left
         alone, an app whose whole pitch is "asks for nothing" would ship
         asking for external storage and the phone state. Remove them
         explicitly, and re-check with:

           aapt2 dump permissions build\app\outputs\flutter-apk\app-release.apk

         Flutter's tooling also injects INTERNET into the debug and profile
         manifests so `flutter run` can reach the Dart VM. That used to be
         the only place it appeared, and the airgap release build is again
         the proof of the no-network claim. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <application
        android:label="Vault Co-Processor"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Vendor (partition) libraries an app may only load when declared,
             on Android 12+ (targetSdk >= 31). required="false": the app
             installs and runs everywhere; the accelerator path reports
             "unavailable" instead of the install failing.

             libcdsprpc.so  FastRPC to the Hexagon DSP. libQnnHtpV81Stub.so
                            links against it; without this entry the QNN HTP
                            delegate cannot open a session on the NPU.
             libOpenCL.so   Adreno OpenCL, used by llama.cpp's GGML_OPENCL
                            backend for GPU prefill/decode. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
